{
  "entities": {
    "warga": {
      "title": "Data Warga",
      "description": "Informasi penduduk berdasarkan NIK",
      "type": "object",
      "properties": {
        "NIK": { "type": "string", "description": "Nomor Induk Kependudukan" },
        "NAMA": { "type": "string", "description": "Nama lengkap warga" },
        "ALAMAT": { "type": "string", "description": "Alamat tempat tinggal" },
        "KEL_DESA": { "type": "string", "description": "Kelurahan atau Desa" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["NIK", "NAMA"]
    },
    "sppt": {
      "title": "Data SPPT",
      "description": "Informasi Pajak Bumi dan Bangunan (SPPT)",
      "type": "object",
      "properties": {
        "NOP": { "type": "string", "description": "Nomor Objek Pajak" },
        "NAMA_WAJIB_PAJAK": { "type": "string", "description": "Nama pemilik atau pembayar pajak" },
        "LUAS_SPPT": { "type": "number", "description": "Luas tanah/bangunan" },
        "NJOP_PERMETER": { "type": "number", "description": "Nilai Jual Objek Pajak per meter" },
        "DUSUN": { "type": "string" },
        "BLOK": { "type": "string" },
        "RT": { "type": "string" },
        "RW": { "type": "string" },
        "DESA": { "type": "string" },
        "KECAMATAN": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["NOP", "NAMA_WAJIB_PAJAK"]
    }
  },
  "firestore": {
    "/master_warga/{nik}": {
      "schema": "warga",
      "description": "Koleksi data master warga untuk pencarian"
    },
    "/master_sppt/{nop}": {
      "schema": "sppt",
      "description": "Koleksi data master SPPT untuk pencarian"
    }
  }
}
