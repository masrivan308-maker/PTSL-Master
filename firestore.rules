rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "masrivan308@gmail.com";
    }

    // --- Master Warga ---
    match /master_warga/{nik} {
      allow read: if true; // Publicly readable as requested
      allow delete: if isAdmin();
      allow create: if isAdmin() && isValidId(nik) && isValidWarga(incoming());
      allow update: if isAdmin() && isValidId(nik) && isValidWarga(incoming()) && (
        // Identity integrity check: NIK inside data must match doc ID
        incoming().NIK == nik &&
        incoming().NIK == existing().NIK 
      );
    }

    function isValidWarga(data) {
      return data.keys().hasAll(['NIK', 'NAMA', 'updatedAt']) &&
             data.NIK is string && data.NIK.size() >= 1 && data.NIK.size() <= 64 &&
             data.NAMA is string && data.NAMA.size() >= 1 && data.NAMA.size() <= 256 &&
             (data.get('ALAMAT', '') is string) && (data.get('ALAMAT', '').size() <= 1024) &&
             (data.get('KEL_DESA', '') is string) && (data.get('KEL_DESA', '').size() <= 256) &&
             data.updatedAt == request.time;
    }

    // --- Master SPPT ---
    match /master_sppt/{nop} {
      allow read: if true; // Publicly readable
      allow delete: if isAdmin();
      allow create: if isAdmin() && isValidId(nop) && isValidSppt(incoming());
      allow update: if isAdmin() && isValidId(nop) && isValidSppt(incoming()) && (
        // Identity integrity check
        incoming().NOP == nop &&
        incoming().NOP == existing().NOP
      );
    }

    function isValidSppt(data) {
      return data.keys().hasAll(['NOP', 'NAMA_WAJIB_PAJAK', 'updatedAt']) &&
             data.NOP is string && data.NOP.size() >= 1 && data.NOP.size() <= 64 &&
             data.NAMA_WAJIB_PAJAK is string && data.NAMA_WAJIB_PAJAK.size() >= 1 && data.NAMA_WAJIB_PAJAK.size() <= 256 &&
             (data.get('LUAS_SPPT', 0) is number) &&
             (data.get('NJOP_PERMETER', 0) is number) &&
             (data.get('DUSUN', '') is string) && (data.get('DUSUN', '').size() <= 256) &&
             (data.get('BLOK', '') is string) && (data.get('BLOK', '').size() <= 256) &&
             (data.get('RT', '') is string) && (data.get('RT', '').size() <= 256) &&
             (data.get('RW', '') is string) && (data.get('RW', '').size() <= 256) &&
             (data.get('DESA', '') is string) && (data.get('DESA', '').size() <= 256) &&
             (data.get('KECAMATAN', '') is string) && (data.get('KECAMATAN', '').size() <= 256) &&
             data.updatedAt == request.time;
    }
    // --- PTSL Data ---
    match /ptsl_data/{docId} {
      allow read: if true; // Visible to everyone as per request
      allow write: if isSignedIn();
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
